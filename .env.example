MONGODB_URI=mongodb://127.0.0.1:27017/khalil
MONGODB_DB_NAME=khalil
CORS_ORIGIN=http://localhost:5176,https://echo-khalil.onrender.com

# Stripe test mode
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_LIVE_REQUEST_PRICE_CENTS=500
STRIPE_LIVE_REQUEST_CURRENCY=cad
FRONTEND_URL=https://echo-khalil.onrender.com

# LiveKit streaming configuration
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Cloudinary storage
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
YOUTUBE_API_KEY=
# Optional Music Archive private local storage (used when Cloudinary is not configured).
# MUSIC_ARCHIVE_STORAGE_DIR=/absolute/path/to/persistent/music-archive
# MUSIC_ARCHIVE_PREVIEW_SECRET=use-a-long-random-secret

# Model for the live AI booking voice conversation.
OPENAI_BOOKING_VOICE_MODEL=gpt-realtime-2.1-mini

# Google Identity Services: OAuth 2.0 Web client ID (public; no secret).
# Register website origins in Google Cloud before enabling.
GOOGLE_CLIENT_ID=
# Render converts audio inside its Docker image; no external worker tunnel.
YOUTUBE_PROCESSING_MODE=server

# Optional private S3 staging for LiveKit recording (e.g. Backblaze B2).
# Create the bucket first. Both endpoints normally use the same HTTPS S3 origin.
ECHO_RECORDING_PUBLIC_ENDPOINT=
ECHO_RECORDING_STORAGE_ENDPOINT=
ECHO_RECORDING_BUCKET=echo-live-archive
ECHO_RECORDING_REGION=us-east-1
ECHO_RECORDING_ACCESS_KEY=
ECHO_RECORDING_SECRET=

# Optional free OpenRouter text booking; keep credentials in Render.
OPENROUTER_API_KEY=
