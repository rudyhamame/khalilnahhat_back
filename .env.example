MONGODB_URI=mongodb://127.0.0.1:27017/khalil
MONGODB_DB_NAME=khalil
CORS_ORIGIN=http://localhost:5176,https://echo-khalil.onrender.com

# Stripe test mode
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_LIVE_REQUEST_PRICE_CENTS=500
STRIPE_LIVE_REQUEST_CURRENCY=cad
FRONTEND_URL=https://echo-khalil.onrender.com

# LiveKit streaming configuration
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Cloudinary storage
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
YOUTUBE_API_KEY=
# Optional Music Archive private local storage (used when Cloudinary is not configured).
# MUSIC_ARCHIVE_STORAGE_DIR=/absolute/path/to/persistent/music-archive
# MUSIC_ARCHIVE_PREVIEW_SECRET=use-a-long-random-secret

# Model for the live AI booking voice conversation.
OPENAI_BOOKING_VOICE_MODEL=gpt-realtime-2.1-mini

# Google Identity Services: OAuth 2.0 Web client ID (public; no secret).
# Register website origins in Google Cloud before enabling.
GOOGLE_CLIENT_ID=
# Render converts audio inside its Docker image; no external worker tunnel.
YOUTUBE_PROCESSING_MODE=server

# Optional private S3 staging for LiveKit recording (e.g. Backblaze B2).
# Create the bucket first. Both endpoints normally use the same HTTPS S3 origin.
ECHO_RECORDING_PUBLIC_ENDPOINT=
ECHO_RECORDING_STORAGE_ENDPOINT=
ECHO_RECORDING_BUCKET=echo-live-archive
ECHO_RECORDING_REGION=us-east-1
ECHO_RECORDING_ACCESS_KEY=
ECHO_RECORDING_SECRET=

# Optional free OpenRouter text booking; keep credentials in Render.
OPENROUTER_API_KEY=

# Venue Intelligence: credentials are used only on the API server.
# Optional override: authorized/self-hosted Nominatim-compatible /search endpoint.
# Without an override or Google key, identification uses the same Photon service as address search.
VENUE_GEOCODER_URL=
# Optional alternative identification provider (Places API New enabled).
GOOGLE_PLACES_API_KEY=
# Licensed web discovery. Without it, only an official website linked by the map provider is crawled.
BRAVE_SEARCH_API_KEY=
VENUE_OVERPASS_URL=https://overpass-api.de/api/interpreter
# Licensed satellite XYZ tile URL; may contain a server-side key and {z}/{x}/{y}.
VENUE_SATELLITE_TILE_URL=
VENUE_SATELLITE_ATTRIBUTION=
# Additional trusted property publishers; never add arbitrary search-result sites automatically.
VENUE_PROPERTY_HOSTS=realtor.ca,loopnet.com,spacelist.ca,cbre.ca,collierscanada.com,cushmanwakefield.com

# Optional hosted/self-hosted Photon override; modest public usage works without a key.
VENUE_PHOTON_URL=
# Set true to require an explicit identification provider instead of the public Photon default.
VENUE_DISABLE_PUBLIC_PHOTON=false

# Optional CPU stem separation; enable only on a provisioned processing instance.
INSTALL_STEM_SEPARATOR=0
STEM_AUTOMATIC_ENABLED=0
# STEM_PYTHON=/opt/stems/bin/python
# STEM_CACHE_DIR=/app/.runtime/stems

# Meshy equipment generation: create an API key in the Meshy Developer Platform.
# Set this in the backend environment, never in VITE_* or source control.
MESHY_API_KEY=

# Alibaba Cloud Model Studio (Qwen). Create a key in Model Studio, then choose "Alibaba Cloud" in the ECHO AI tab.
DASHSCOPE_API_KEY=
# Use the API Host shown when creating the key in the same region/workspace, followed by /compatible-mode/v1.
# Singapore example: https://WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# If omitted, the legacy international endpoint is used.
# DASHSCOPE_BASE_URL=

# Echo AI Administrator uses Responses API independently of the customer booking provider.
# Reuses OPENAI_API_KEY. Leave model blank to use the configured OpenAI chat model,
# or gpt-4o-mini when the booking provider is not OpenAI.
OPENAI_ADMIN_MODEL=
# api-process (default) or external. External requires a separately running worker:
# npm run ai-administrator:worker, with the same MongoDB/auth/storage/provider environment.
ECHO_ADMIN_WORKER_MODE=api-process
# Android task notifications (server only). Standard Firebase service account or ADC secret file.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json

# Ollama Cloud text provider (server only; no model installation needed).
OLLAMA_API_KEY=
# Optional compatible cloud endpoint; defaults to https://ollama.com/v1
# OLLAMA_BASE_URL=https://ollama.com/v1
