            "private": true,
            "locked": "account",
            "short": "Phone contact",
            "shortAr": "\u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0639\u0628\u0631 \u0627\u0644\u0647\u0627\u062a\u0641",
            "optionNames": {
