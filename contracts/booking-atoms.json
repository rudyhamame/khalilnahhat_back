{
  "version": 2,
  "authority": "Data Atoms Booking Tree. Edit this file; eventOrderContract.json and all web/Android copies are generated. Booking journey statuses remain in booking-journey.json.",
  "steps": [
    {
      "id": "customer",
      "title": "Personal info",
      "ar": "\u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0634\u062e\u0635\u064a\u0629",
      "description": "Tell us who we are planning with and how to reach you, so your quote request goes to the right person.",
      "descriptionAr": "\u0623\u062e\u0628\u0631\u0646\u0627 \u0645\u0639 \u0645\u0646 \u0646\u062e\u0637\u0637 \u0648\u0643\u064a\u0641 \u0646\u0635\u0644 \u0625\u0644\u064a\u0643\u060c \u0644\u064a\u0635\u0644 \u0637\u0644\u0628 \u0639\u0631\u0636 \u0627\u0644\u0633\u0639\u0631 \u0625\u0644\u0649 \u0627\u0644\u0634\u062e\u0635 \u0627\u0644\u0645\u0646\u0627\u0633\u0628.",
      "code": "01"
    },
    {
      "id": "event",
      "title": "Event info",
      "ar": "\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0641\u0639\u0627\u0644\u064a\u0629",
      "viewport": "availability",
      "face": "calendar",
      "chapter": "02",
      "description": "Your occasion, date, guests and venue shape everything that follows: the sound, the lighting and the timing of the night.",
      "descriptionAr": "\u0645\u0646\u0627\u0633\u0628\u062a\u0643 \u0648\u0645\u0648\u0639\u062f\u0643 \u0648\u0636\u064a\u0648\u0641\u0643 \u0648\u0645\u0643\u0627\u0646\u0643 \u062a\u062d\u062f\u062f \u0643\u0644 \u0645\u0627 \u064a\u0644\u064a: \u0627\u0644\u0635\u0648\u062a \u0648\u0627\u0644\u0625\u0636\u0627\u0621\u0629 \u0648\u062a\u0648\u0642\u064a\u062a \u0627\u0644\u0633\u0647\u0631\u0629.",
      "code": "02"
    },
    {
      "id": "music",
      "title": "Echo Services",
      "ar": "\u062e\u062f\u0645\u0627\u062a \u0625\u064a\u0643\u0648",
      "viewport": "work",
      "chapter": "03",
      "description": "Add Echo services to your event: DJ Khalil, MC hosting and rental equipment. Then share the music you love: languages, genres, special moments and favourite songs.",
      "descriptionAr": "\u0623\u0636\u0641 \u062f\u064a \u062c\u064a \u062e\u0644\u064a\u0644 \u0625\u0644\u0649 \u0641\u0639\u0627\u0644\u064a\u062a\u0643\u060c \u062b\u0645 \u0634\u0627\u0631\u0643\u0646\u0627 \u0627\u0644\u0645\u0648\u0633\u064a\u0642\u0649 \u0627\u0644\u062a\u064a \u062a\u062d\u0628\u0647\u0627: \u0627\u0644\u0644\u063a\u0627\u062a \u0648\u0627\u0644\u0623\u0646\u0648\u0627\u0639 \u0648\u0627\u0644\u0644\u062d\u0638\u0627\u062a \u0627\u0644\u062e\u0627\u0635\u0629 \u0648\u0623\u063a\u0627\u0646\u064a\u0643 \u0627\u0644\u0645\u0641\u0636\u0644\u0629.",
      "code": "03",
      "requiresAny": [
        "dj",
        "mc",
        "rental"
      ]
    },
    {
      "id": "additional",
      "title": "Additional info",
      "ar": "\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0625\u0636\u0627\u0641\u064a\u0629",
      "description": "Inspiration, documents, a voucher and any last notes. Submitting requests a quote; it does not reserve your date.",
      "descriptionAr": "\u0623\u0641\u0643\u0627\u0631 \u0648\u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0648\u0642\u0633\u064a\u0645\u0629 \u0648\u0623\u064a \u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0623\u062e\u064a\u0631\u0629. \u0627\u0644\u0625\u0631\u0633\u0627\u0644 \u064a\u0637\u0644\u0628 \u0639\u0631\u0636 \u0633\u0639\u0631 \u0648\u0644\u0627 \u064a\u062d\u062c\u0632 \u0645\u0648\u0639\u062f\u0643.",
      "code": "04"
    }
  ],
