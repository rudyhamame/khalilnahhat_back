{
  "name": "khalil_back",
  "version": "1.0.0",
  "description": "Minimal booking API for the Khalil Nahhat portfolio site.",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon",
    "start": "node src/server.js",
    "check": "node --check src/server.js",
    "test:project-chat": "node --test test/echo-project-chat.test.js test/echo-project-chat-features.test.js",
    "test:music-ontology": "node --test test/music-ontology.test.js test/music-ontology.integration.test.js test/music-archive.test.js test/music-archive-files.test.js",
    "music-ontology:audit": "node scripts/music-ontology-migrate.js audit",
    "test:ai-administrator": "node --test test/ai-administrator.integration.test.js",
    "ai-administrator:worker": "node scripts/ai-administrator-worker.js",
    "ai-administrator:audit": "node scripts/audit-admin-capabilities.js",
    "test:booking": "node --test test/client-booking-lifecycle.test.js test/service-request-submission.test.js test/service-request-idempotency.test.js test/quote-validation.test.js src/event-order.test.js test/assisted-booking-flow.test.js src/event-drafts.test.js src/booking-conversations.test.js src/ai-booking.test.js src/ai-booking-stream.test.js test/voice-tool-completion.test.js test/voice-context-current.test.js test/voice-recovery.test.js"
  },
  "keywords": [
    "express",
    "booking",
    "portfolio"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cheerio": "^1.2.0",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^11.3.1",
    "livekit-server-sdk": "^2.17.0",
    "minio": "^8.0.7",
    "mongoose": "^9.8.1",
    "multer": "^2.2.0",
    "robots-parser": "^3.0.1",
    "ws": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
