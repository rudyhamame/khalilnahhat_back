{
 "version": 1,
 "timezone": "America/Toronto",
 "sections": [
  {
   "id": "customer",
   "title": "About you",
   "ar": "عنك",
   "fields": [
    {
     "key": "customer.fullName",
     "label": "Your name",
     "ar": "اسمك الكامل",
     "required": true,
     "private": true
    },
    {
     "key": "customer.email",
     "label": "Email",
     "ar": "البريد الإلكتروني",
     "type": "email",
     "required": true,
     "private": true
    },
    {
     "key": "customer.phone",
     "label": "Phone number",
     "ar": "رقم الهاتف",
     "type": "tel",
     "maxLength": 30,
     "required": true,
     "private": true
    },
    {
     "key": "customer.contactMethod",
     "label": "How should we reach you?",
     "ar": "كيف نتواصل معك؟",
     "options": [
      "email",
      "phone",
      "whatsapp"
     ],
     "required": true,
     "private": true
    },
    {
     "key": "customer.company",
     "label": "Company name (only if this is a business event)",
     "ar": "اسم الشركة (فقط إذا كانت فعالية شركة)",
     "maxLength": 120,
     "private": true
    }
   ]
  },
  {
   "id": "event",
   "title": "About the event",
   "ar": "عن الفعالية",
   "fields": [
    {
     "key": "event.type",
     "label": "What kind of event is it?",
     "ar": "ما نوع الفعالية؟",
     "options": [
      "wedding",
      "engagement",
      "birthday",
      "corporate",
      "party",
      "graduation",
      "other"
     ],
     "required": true
    },
    {
     "key": "event.date",
     "label": "Event date",
     "ar": "تاريخ الفعالية",
     "type": "date",
     "required": true
    },
    {
     "key": "event.startTime",
     "label": "What time does it start?",
     "ar": "متى تبدأ؟",
     "type": "time",
     "required": true
    },
    {
     "key": "event.endTime",
     "label": "What time does it end? (after midnight is fine)",
     "ar": "متى تنتهي؟ (بعد منتصف الليل مقبول)",
     "type": "time",
     "required": true
    },
    {
     "key": "event.guestCount",
     "label": "About how many guests?",
     "ar": "كم عدد الضيوف تقريباً؟",
     "type": "number",
     "max": 100000,
     "required": true
    },
    {
     "key": "event.venue.name",
     "label": "Venue name",
     "ar": "اسم المكان",
     "maxLength": 160,
     "required": true
    },
    {
     "key": "event.venue.address",
     "label": "Venue street address",
     "ar": "عنوان المكان",
     "maxLength": 240,
     "required": true,
     "private": true
    },
    {
     "key": "event.venue.city",
     "label": "City",
     "ar": "المدينة",
     "maxLength": 80,
     "required": true
    },
    {
     "key": "event.venue.postalCode",
     "label": "Postal code",
     "ar": "الرمز البريدي",
     "maxLength": 12,
     "required": true,
     "private": true
    },
    {
     "key": "event.venue.area",
     "label": "Is the venue inside the GTA (Greater Toronto Area)?",
     "ar": "هل المكان داخل تورونتو الكبرى (GTA)؟",
     "options": [
      "gta",
      "outside_gta"
     ],
     "required": true
    },
    {
     "key": "event.venue.setting",
     "label": "Indoor or outdoor?",
     "ar": "داخلي أم خارجي؟",
     "options": [
      "indoor",
      "outdoor",
      "both"
     ],
     "required": true
    },
    {
     "key": "event.setup.requirements",
     "label": "Anything we should know about the space or setup? (optional)",
     "ar": "هل هناك ما يجب أن نعرفه عن المكان أو التجهيز؟ (اختياري)",
     "type": "textarea"
    },
    {
     "key": "services",
     "label": "What do you need from us?",
     "ar": "ماذا تحتاج منا؟",
     "type": "multi",
     "options": [
      "dj",
      "sound",
      "lighting",
      "led",
      "fx",
      "rental",
      "corporate"
     ],
     "required": true
    }
   ]
  },
  {
