{
 "version": 1,
 "timezone": "America/Toronto",
 "sections": [
  {
   "id": "customer",
   "title": "About you",
   "ar": "عنك",
   "fields": [
    {
     "key": "customer.fullName",
     "label": "Your name",
     "ar": "اسمك الكامل",
     "required": true,
     "private": true
    },
    {
     "key": "customer.email",
     "label": "Email",
     "ar": "البريد الإلكتروني",
     "type": "email",
     "required": true,
     "private": true
    },
    {
     "key": "customer.phone",
     "label": "Phone number",
     "ar": "رقم الهاتف",
     "type": "tel",
     "maxLength": 30,
     "required": true,
     "private": true
    },
    {
     "key": "customer.contactMethod",
     "label": "How should we reach you?",
     "ar": "كيف نتواصل معك؟",
     "options": [
      "email",
      "phone",
      "whatsapp"
     ],
     "required": true,
     "private": true
    },
    {
     "key": "customer.company",
     "label": "Company name (only if this is a business event)",
     "ar": "اسم الشركة (فقط إذا كانت فعالية شركة)",
     "maxLength": 120,
     "private": true
    }
   ]
  },
  {
   "id": "event",
   "title": "About the event",
   "ar": "عن الفعالية",
   "fields": [
    {
     "key": "event.type",
     "label": "What kind of event is it?",
     "ar": "ما نوع الفعالية؟",
     "options": [
      "wedding",
      "engagement",
      "birthday",
      "corporate",
      "party",
      "graduation",
      "other"
     ],
     "required": true
    },
    {
     "key": "event.date",
     "label": "Event date",
     "ar": "تاريخ الفعالية",
     "type": "date",
     "required": true
    },
    {
     "key": "event.startTime",
     "label": "What time does it start?",
     "ar": "متى تبدأ؟",
     "type": "time",
     "required": true
    },
    {
     "key": "event.endTime",
     "label": "What time does it end? (after midnight is fine)",
     "ar": "متى تنتهي؟ (بعد منتصف الليل مقبول)",
     "type": "time",
     "required": true
    },
    {
     "key": "event.guestCount",
     "label": "About how many guests?",
     "ar": "كم عدد الضيوف تقريباً؟",
     "type": "number",
     "max": 100000,
     "required": true
    },
    {
     "key": "event.venue.name",
     "label": "Venue name",
     "ar": "اسم المكان",
     "maxLength": 160,
     "required": true
    },
    {
     "key": "event.venue.address",
     "label": "Venue street address",
     "ar": "عنوان المكان",
     "maxLength": 240,
     "required": true,
     "private": true
    },
    {
     "key": "event.venue.city",
     "label": "City",
     "ar": "المدينة",
     "maxLength": 80,
     "required": true
    },
    {
     "key": "event.venue.postalCode",
     "label": "Postal code",
     "ar": "الرمز البريدي",
     "maxLength": 12,
     "required": true,
     "private": true
    },
    {
     "key": "event.venue.area",
     "label": "Is the venue inside the GTA (Greater Toronto Area)?",
     "ar": "هل المكان داخل تورونتو الكبرى (GTA)؟",
     "options": [
      "gta",
      "outside_gta"
     ],
     "required": true
    },
    {
     "key": "event.venue.setting",
     "label": "Indoor or outdoor?",
     "ar": "داخلي أم خارجي؟",
     "options": [
      "indoor",
      "outdoor",
      "both"
     ],
     "required": true
    },
    {
     "key": "event.setup.requirements",
     "label": "Anything we should know about the space or setup? (optional)",
     "ar": "هل هناك ما يجب أن نعرفه عن المكان أو التجهيز؟ (اختياري)",
     "type": "textarea"
    },
    {
     "key": "services",
     "label": "What do you need from us?",
     "ar": "ماذا تحتاج منا؟",
     "type": "multi",
     "options": [
      "dj",
      "sound",
      "lighting",
      "led",
      "fx",
      "rental",
      "corporate"
     ],
     "required": true
    }
   ]
  },
  {
   "id": "music",
   "title": "Music & entertainment (optional)",
   "ar": "الموسيقى والترفيه (اختياري)",
   "fields": [
    {
     "key": "music.styles",
     "label": "What music do you like?",
     "ar": "ما نوع الموسيقى التي تفضلها؟",
     "type": "multi",
     "options": [
      "arabic",
      "english",
      "mixed",
      "other"
     ]
    },
    {
     "key": "music.otherPreferences",
     "label": "Any favourite songs or artists? (optional)",
     "ar": "أغانٍ أو فنانون مفضلون؟ (اختياري)",
     "type": "textarea"
    },
    {
     "key": "music.djMc",
     "label": "Should the DJ also host and make announcements (MC)? (optional)",
     "ar": "هل تريد أن يقدّم الدي جي الحفل أيضاً (MC)؟ (اختياري)",
     "type": "textarea"
    },
    {
     "key": "music.entrance",
     "label": "Is there a special entrance, like the couple or bridal party? (optional)",
     "ar": "هل هناك دخول خاص مثل العروسين أو المرافقين؟ (اختياري)",
     "type": "textarea"
    },
    {
     "key": "music.customMix",
     "label": "Do you want a custom song mix made for you? (optional)",
     "ar": "هل تريد ميكس مخصصاً لك؟ (اختياري)",
     "type": "textarea"
    },
    {
     "key": "music.announcements",
     "label": "Any special announcements to make? (optional)",
     "ar": "هل هناك إعلانات خاصة؟ (اختياري)",
     "type": "textarea"
    }
   ]
  },
  {
   "id": "references",
   "title": "Extras (optional)",
   "ar": "إضافات (اختياري)",
   "fields": [
    {
     "key": "references.images",
     "label": "Links to inspiration photos (optional, one link per line)",
     "ar": "روابط صور ملهمة (اختياري، رابط في كل سطر)",
     "type": "links",
     "private": true
    },
    {
     "key": "references.documents",
     "label": "Links to event documents (optional, one link per line)",
     "ar": "روابط مستندات الفعالية (اختياري، رابط في كل سطر)",
     "type": "links",
     "private": true
    },
    {
     "key": "additional.specialRequests",
     "label": "Any special requests? (optional)",
     "ar": "طلبات خاصة؟ (اختياري)",
     "type": "textarea"
    },
    {
     "key": "additional.notes",
     "label": "Anything else we should know? (optional)",
     "ar": "أي شيء آخر نحتاج معرفته؟ (اختياري)",
     "type": "textarea"
    }
   ]
  }
 ]
}
